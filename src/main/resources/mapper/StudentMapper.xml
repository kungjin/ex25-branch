<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ex25_branch.mapper.StudentMapper">

  <select id="findAll" resultType="com.ex25_branch.domain.Student">
    SELECT * FROM student ORDER BY id DESC
  </select>

  <select id="findById" parameterType="long" resultType="com.ex25_branch.domain.Student">
    SELECT * FROM student WHERE id = #{id}
  </select>

  <insert id="insert" parameterType="com.ex25_branch.domain.Student"
          useGeneratedKeys="true" keyProperty="id">
    INSERT INTO student(name, email, age)
    VALUES (#{name}, #{email}, #{age})
  </insert>

  <update id="update" parameterType="com.ex25_branch.domain.Student">
    UPDATE student
    SET name = #{name}, email = #{email}, age = #{age}
    WHERE id = #{id}
  </update>

  <delete id="delete" parameterType="long">
    DELETE FROM student WHERE id = #{id}
  </delete>

</mapper>




